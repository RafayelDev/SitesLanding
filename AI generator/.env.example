# PixelForge AI environment
# Copy to .env.local and fill in real values. Never commit secrets.

# --- Required: Supabase ---
# Project URL from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# anon / public key (safe for the browser, still protect with RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# service_role key — SERVER ONLY. Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Required for a working public URL (password reset, webhooks) ---
APP_URL=http://localhost:3000

# --- Image generation (Replicate) ---
# Create a token at https://replicate.com/account/api-tokens
# Without this token the app runs, but generation is disabled with a setup banner.
REPLICATE_API_TOKEN=r8_xxxxxxxx

# Optional. Required only if you enable Replicate webhooks from a public APP_URL.
# Dashboard → Webhooks / or the signing secret shown when configuring webhooks.
REPLICATE_WEBHOOK_SECRET=

# Optional override. Default model is FLUX Schnell (fast, inexpensive).
# Example: black-forest-labs/flux-schnell
REPLICATE_MODEL=black-forest-labs/flux-schnell

# Milliseconds to wait when polling a prediction. Default 50000.
GENERATION_TIMEOUT_MS=50000

# Default monthly generation cap for new users.
DEFAULT_MONTHLY_GENERATION_LIMIT=50

# --- Playwright E2E (optional) ---
# Create a dedicated test user in Supabase Auth. Do not use a real admin password in CI logs.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
